    <trackHistory>false</trackHistory>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>open</fullName>
                <default>false</default>
                <label>Open</label>
            </value>
            <value>
                <fullName>closed</fullName>
                <default>false</default>
                <label>Closed</label>
            </value>
            <value>
                <fullName>cancelled</fullName>
                <default>false</default>
                <label>Cancelled</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
